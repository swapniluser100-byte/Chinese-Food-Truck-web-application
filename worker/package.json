{
  "name": "chinese-food-truck-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute chinese_food_truck --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute chinese_food_truck --local --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute chinese_food_truck --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute chinese_food_truck --remote --file=./seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.90.0"
  }
}
